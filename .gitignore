# Dependencies, installed with npm install
node_modules/

# Local Wrangler state and build cache
.wrangler/

# Staged copy of public/ that is deployed (see scripts/stage.mjs)
.deploy/

# Local secrets for Wrangler and other tools
.dev.vars
.env*

# Operating system files (macOS, Windows)
.DS_Store
Thumbs.db
desktop.ini

# Git bundles, used only to move history between machines
*.bundle
